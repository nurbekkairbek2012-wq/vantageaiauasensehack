# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version

# --- Тесты и линтеры ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Секреты ---
# Токен бота и токены API не должны попадать в репозиторий ни при каких
# обстоятельствах: публичный репозиторий индексируется, и утёкший токен
# находят автоматические сканеры за минуты.
.env
.env.*
!.env.example
*.key
*.pem
secrets/
**/fly.secrets
**/*token*.txt

# --- Данные (тяжёлые, не версионируем) ---
data/raw/
data/interim/
data/cache/
data/chips/
*.tif
*.tiff
*.nc
*.zarr/
*.parquet

# --- Артефакты моделей ---
models/*.pt
models/*.pth
models/*.onnx
mlruns/

# --- Выходные артефакты ---
outputs/
# Прогоны по отдельным областям кладутся рядом (outputs_astana_north и
# подобные) — это те же артефакты, только под своим именем. В репозиторий
# попадает не это, а map-data/ через vantage publish.
outputs_*/
*.pdf
!docs/**/*.pdf

# --- Фронтенд ---
web/node_modules/
web/dist/
# Данные карты генерируются командами vantage sample / vantage run.
# В репозитории их быть не должно: синтетику легко принять за результат
# настоящего прогона.
web/data/

# --- ОС / IDE ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# --- Разрешённые исключения ---
# Малые эталонные данные для тестов версионируем явно
!tests/fixtures/**

# --- Скиллы дизайна (вендорятся локально, 14 МБ) ---
# Ставятся клонированием репозиториев, см. docs/HANDOFF.md.
.claude/skills/
.impeccable/

# --- Сборка фронтенда ---
web-next/node_modules/
web-next/dist/

# Резервные копии прогона и логи диагностики: рабочие файлы одного вечера,
# в истории им делать нечего.
outputs_real_backup_*/
data/chips_backup_*/
ring_run.log
diag.log

# --- Чужие датасеты и скачанные снимки ---
#
# Архивы AerialWaste — девять гигабайт. В .gitignore их не было, и один
# `git add -A` уничтожил бы репозиторий необратимо: из истории git такое
# вычищается только переписыванием всех коммитов.
#
# Датасет открытый (CC BY) и качается скриптом, поэтому хранить его в
# репозитории незачем — см. scripts/train_aerialwaste.py.
data/aerialwaste/
data/highres/

# --- Логи прогонов ---
# Пишутся в корень, растут до сотен мегабайт и никому, кроме текущего
# прогона, не нужны.
*.log

# --- Собранные обучающие наборы и листы просмотра ---
# Восстанавливаются скриптами из открытых источников; в репозитории
# заняли бы сотни мегабайт без пользы.
data/drone/
data/drone_crops/
data/kz_dataset/
data/combined_embeddings.npz
review*/
